# Handle line endings automatically for files detected as text 
# and leave binary files untouched.
* text=auto

# Explicitly set line endings to LF for shell scripts
*.sh text eol=lf

# Explicitly set line endings to LF for other common files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
